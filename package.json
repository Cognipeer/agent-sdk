{
  "name": "@cognipeer/agent-sdk",
  "version": "0.20.0",
  "description": "Composable lightweight smart agent core (no LangGraph) with pluggable model adapters.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./model-rules": {
      "types": "./dist/model-rules.d.ts",
      "import": "./dist/model-rules.mjs",
      "require": "./dist/model-rules.cjs"
    },
    "./model-rules.json": "./dist/model-rules.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:real": "vitest run tests/integration/realOpenAI.integration.test.ts",
    "test:critical": "vitest run tests/integration/criticalFeatures.integration.test.ts",
    "test:matrix": "vitest run tests/integration/providerMatrix.integration.test.ts",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "prepublishOnly": "npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "npm run build"
  },
  "keywords": [
    "agent",
    "ai",
    "llm",
    "autonomous",
    "openai",
    "anthropic",
    "sdk",
    "typescript",
    "cognipeer",
    "ai-agent",
    "agents",
    "tool-calling",
    "mcp",
    "multi-agent"
  ],
  "author": "cognipeer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cognipeer/agent-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Cognipeer/agent-sdk/issues"
  },
  "homepage": "https://docs.cognipeer.com/agent-sdk/",
  "peerDependencies": {
    "@langchain/core": "^0.3.0 || ^1.0.0",
    "@langchain/openai": "^0.3.0 || ^1.0.0",
    "@langchain/anthropic": "^0.3.0 || ^1.0.0",
    "@langchain/aws": "^0.3.0 || ^1.0.0",
    "@langchain/google-vertexai": "^0.3.0 || ^1.0.0",
    "@langchain/community": "^0.3.0 || ^1.0.0",
    "@langchain/ollama": "^0.3.0 || ^1.0.0",
    "@langchain/langgraph-sdk": "^0.3.0 || ^1.0.0",
    "langchain": "^0.3.0 || ^1.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@langchain/openai": {
      "optional": true
    },
    "@langchain/anthropic": {
      "optional": true
    },
    "@langchain/aws": {
      "optional": true
    },
    "@langchain/google-vertexai": {
      "optional": true
    },
    "@langchain/community": {
      "optional": true
    },
    "@langchain/ollama": {
      "optional": true
    },
    "@langchain/langgraph-sdk": {
      "optional": true
    },
    "langchain": {
      "optional": true
    }
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "nanoid": "^3.3.11",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@langchain/openai": "^1.2.4",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.5.4",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.9.0",
    "openai": "^6.17.0",
    "protobufjs": "8.8.0",
    "tsup": "^8.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitepress": "^1.5.0",
    "vitest": "^4.0.18"
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  }
}
