      },
      "sampling": {
        "temperature": "thinking-requires-1",
        "topP": true,
        "topK": true,
        "penalties": true,
        "logprobs": true
      },
      "maxTokensParam": "max_tokens",
      "chatTools": {
        "reasoning": "any"
      },
      "source": "docs",
      "note": "Claude 3.7 and 4.0-4.5: thinking:{type:enabled,budget_tokens}; every effort maps to a budget; sampling overrides are not allowed while thinking."
    },
    {
      "id": "anthropic-default",
      "family": "anthropic",
      "match": ".*",
      "reasoning": {
        "style": "budget",
        "efforts": [
          "none",
          "minimal",
          "low",
