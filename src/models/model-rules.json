    },
    {
      "id": "claude-legacy-budget",
      "family": "anthropic",
      "match": "^claude-(?:3|4-|(?:opus|sonnet|haiku)-4)",
      "reasoning": {
        "style": "budget",
        "efforts": [
          "none",
